#!/bin/sh
# Lock a wlroots session. Idempotent. Turn off the outputs while locked.

set -eu

LOCKER=${LOCKER:=swaylock}
OUTPUTS_OFF=${OUTPUTS_OFF:="wlopm --off '*'"}
OUTPUTS_ON=${OUTPUTS_ON:="wlopm --on '*'"}

uid=$(id -u)

locked() {
    pgrep -x -u "$uid" $LOCKER >/dev/null 2>&1
}

# Already locked: callers may proceed immediately.
if locked; then
    exit 0
fi

# Blank the outputs after a short idle period while locked.
swayidle \
    timeout 10 "$OUTPUTS_OFF" \
    resume     "$OUTPUTS_ON" &
blanker=$!

# swaylock stays in the foreground of this subshell so we observe it exiting.
{
    $LOCKER || true
    kill "$blanker" 2>/dev/null || true
    eval $OUTPUTS_ON >/dev/null 2>&1 || true
    loginctl unlock-session >/dev/null 2>&1 || true
} &

# Bounded wait for the lock surface, so this can never spin forever.
i=0
while ! locked; do
    i=$((i + 1))
    if [ "$i" -gt 100 ]; then   # ~5s
        echo "lock.sh: $LOCKER failed to start" >&2
        kill "$blanker" 2>/dev/null || true
        exit 1
    fi
    sleep 0.05
done
