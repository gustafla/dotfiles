#!/usr/bin/env bash
DMENU=${DMENU:=wmenu}

selected=$(find ${PASSWORD_STORE_DIR:=$HOME/.password-store} -type f -path '*/*.gpg' -printf '%P\n' | sed 's/.gpg$//' | $DMENU "$@")
[ -z "$selected" ] && exit

old="$(wl-paste)"

cleartext=$(pass show "$selected")
case "$cleartext" in 
  otpauth://*)
    pass otp "$selected" | wl-copy;;
  *)
    wl-copy <<< "$cleartext";;
esac

sleep 20
wl-copy <<< "$old"
