#!/bin/bash
set -e

[[ -z $1 ]] || [[ -z $2 ]] && { echo "usage: $0 [[user@]host] [disk]..."; exit 1; }
HOST=$1
shift

if ! mountpoint -q /mnt; then
  echo "=== Unlocking Storage Drives ==="
  read -s -p "Enter LUKS Password: " PASSWORD
  echo

  for DISK in "$@"; do
    echo -n "$PASSWORD" | sudo cryptsetup open "$DISK" backup-$(basename "$DISK") -
  done
  echo "Drives unlocked"
  echo "Mounting filesystem..."
  sudo mount -o compress=zstd /dev/mapper/backup-$(basename "$1") /mnt
else
  read -p "Mountpoint /mnt is already mounted. Continue? [y/n]: " YN
  case $YN in
    [Yy]*) ;;  
    [Nn]*) exit 1 ;;
  esac
fi

# Ensure destination directories exist
sudo mkdir -p /mnt/snapshots /mnt/rootfs-snapshots

# ==========================================
# Storage backup (/srv/storage)
# ==========================================
echo -e "\n=== Starting Storage Backup ==="
echo "Creating new snapshot on $HOST..."
ssh "$HOST" 'sudo btrfs subvolume snapshot -r /srv/storage /srv/storage/snapshots/$(date -I)' || echo "Could not create a new snapshot on $HOST."
REMOTE_SNAPS=$(ssh "$HOST" "sudo btrfs subvolume list -o /srv/storage/snapshots" | awk -F 'path snapshots/' '{print $2}' | sort)
LOCAL_SNAPS=$(sudo btrfs subvolume list -o /mnt/snapshots | awk -F 'path snapshots/' '{print $2}' | sort)

if [[ -z $REMOTE_SNAPS ]]; then
  echo "Remote storage appears to have no snapshots. This is a bug."
  exit 1
fi

LATEST_COMMON=$(comm -12 <(echo "$LOCAL_SNAPS") <(echo "$REMOTE_SNAPS") | tail -n 1)

if [[ -z $LATEST_COMMON ]]; then
  echo "No common storage snapshots found. Initiating full transfer..."
  FIRST=$(echo "$REMOTE_SNAPS" | head -n 1)
  echo "Transferring $FIRST..."
  systemd-inhibit --what=shutdown:sleep --who="backup" --why="btrfs sync" ssh "$HOST" "sudo btrfs send /srv/storage/snapshots/$FIRST" | sudo btrfs receive /mnt/snapshots
  LATEST_COMMON=$FIRST
fi

SYNC_FLAG=0
for SNAP in $REMOTE_SNAPS; do
  if [[ "$SNAP" == "$LATEST_COMMON" ]]; then
    SYNC_FLAG=1
    continue
  fi

  if (( SYNC_FLAG == 1 )); then
    echo "Transferring $SNAP (parent: $LATEST_COMMON)..."
    systemd-inhibit --what=shutdown:sleep --who="backup" --why="btrfs sync" ssh "$HOST" "sudo btrfs send -p /srv/storage/snapshots/$LATEST_COMMON /srv/storage/snapshots/$SNAP" | sudo btrfs receive /mnt/snapshots
    LATEST_COMMON=$SNAP
  fi
done

# ==========================================
# RootFS backup (snapper)
# ==========================================
echo -e "\n=== Starting RootFS Backup ==="

# Clean up dangling snapshot from a previous interrupted transfer
if sudo btrfs subvolume show /mnt/rootfs-snapshots/snapshot &>/dev/null; then
  echo "Cleaning up dangling incomplete rootfs snapshot..."
  sudo btrfs subvolume delete /mnt/rootfs-snapshots/snapshot
fi

# Extract just the numerical ID from snapper's path structure, sort LEXICALLY
REMOTE_ROOT_SNAPS=$(ssh "$HOST" "sudo btrfs subvolume list -o /.snapshots" | grep 'snapshot$' | awk -F '.snapshots/' '{print $2}' | cut -d/ -f1 | sort)
LOCAL_ROOT_SNAPS=$(sudo btrfs subvolume list -o /mnt/rootfs-snapshots | awk -F 'rootfs-snapshots/' '{print $2}' | sort)

if [[ -z $REMOTE_ROOT_SNAPS ]]; then
  echo "Remote rootfs has no snapper snapshots."
else
  # Sort numerically AFTER the lexical comm intersection
  COMMON_ROOT_SNAPS=$(comm -12 <(echo "$LOCAL_ROOT_SNAPS") <(echo "$REMOTE_ROOT_SNAPS") | sort -n)
  LATEST_COMMON_ROOT=$(echo "$COMMON_ROOT_SNAPS" | tail -n 1)

  if [[ -z $LATEST_COMMON_ROOT ]]; then
    # Start the chain with the oldest numerical snapshot
    FIRST_ROOT=$(echo "$REMOTE_ROOT_SNAPS" | sort -n | head -n 1)
    echo "No common rootfs snapshots found. Transferring initial full snapshot ($FIRST_ROOT)..."
    systemd-inhibit --what=shutdown:sleep --who="backup" --why="btrfs sync" ssh "$HOST" "sudo btrfs send /.snapshots/$FIRST_ROOT/snapshot" | sudo btrfs receive /mnt/rootfs-snapshots
    sudo mv /mnt/rootfs-snapshots/snapshot /mnt/rootfs-snapshots/$FIRST_ROOT
    LATEST_COMMON_ROOT=$FIRST_ROOT
  fi

  SYNC_FLAG=0
  # Ensure chronological iteration by sorting numerically
  for SNAP in $(echo "$REMOTE_ROOT_SNAPS" | sort -n); do
    if [[ "$SNAP" == "$LATEST_COMMON_ROOT" ]]; then
      SYNC_FLAG=1
      continue
    fi
    
    if (( SYNC_FLAG == 1 )); then
      echo "Transferring rootfs snapshot $SNAP (parent: $LATEST_COMMON_ROOT)..."
      systemd-inhibit --what=shutdown:sleep --who="backup" --why="btrfs sync" ssh "$HOST" "sudo btrfs send -p /.snapshots/$LATEST_COMMON_ROOT/snapshot /.snapshots/$SNAP/snapshot" | sudo btrfs receive /mnt/rootfs-snapshots
      
      # Rename to its snapper id
      sudo mv /mnt/rootfs-snapshots/snapshot /mnt/rootfs-snapshots/$SNAP
      LATEST_COMMON_ROOT=$SNAP
    fi
  done
fi

echo -e "\nAll backups complete."
read -p "Unmount /mnt? [y/n]: " YN
case $YN in
  [Yy]*) ;;
  [Nn]*) exit 0 ;;
esac

sudo umount /mnt
for DISK in "$@"; do
  sudo cryptsetup close backup-$(basename "$DISK")
done
