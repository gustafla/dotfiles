#!/usr/bin/env bash
DMENU=${DMENU:=wmenu}

selected=$(find ${PASSWORD_STORE_DIR:=$HOME/.password-store} -type f -path '*/*.gpg' -printf '%P\n' | sed 's/.gpg$//' | $DMENU "$@")
[ -z "$selected" ] && exit

case $(pass show "$selected") in 
  otpauth://*)
    pass otp -c "$selected";;
  *)
    pass -c "$selected";;
esac
